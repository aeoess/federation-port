      "id": "S1",
      "step": 1,
      "name": "subject_not_a_plain_object",
      "description": "An established target-bound claim whose subject is null, an array or a string. The claim becomes unavailable and target_match is invalid_subject.",
      "variants": [
        {
          "source": "synthetic",
          "runtime_target": "https://a.example/a2a",
          "result": {
            "claim": "x.covers_target",
            "status": "established",
            "subject": null
          }
        },
        {
          "source": "synthetic",
          "runtime_target": "https://a.example/a2a",
          "result": {
            "claim": "x.covers_target",
            "status": "established",
            "subject": [
              "https://a.example/a2a"
            ]
          }
        },
        {
          "source": "synthetic",
          "runtime_target": "https://a.example/a2a",
          "result": {
            "claim": "x.covers_target",
            "status": "established",
            "subject": "https://a.example/a2a"
          }
        }
      ],
      "expected": {
        "claim_status": "unavailable",
        "claim_reason": "adapter_protocol_violation:subject",
        "target_match": "invalid_subject",
        "decision": "refuse",
        "refusal": "required_claim_unavailable:x.covers_target"
      }
    },
    {
